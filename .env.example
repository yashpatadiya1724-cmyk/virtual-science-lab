# Virtual Science Lab Environment Configuration
# Copy this file to .env and configure local values

PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/virtual_science_lab

# Security & Sessions
JWT_SECRET=your_jwt_secret_min_32_chars_here
SESSION_SECRET=your_session_secret_here

# Client URL (for CORS)
CLIENT_URL=http://localhost:3000
